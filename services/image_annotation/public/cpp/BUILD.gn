source_set("cpp") {
  sources = [
    "image_processor.cc",
    "image_processor.h",
  ]

  public_deps = [
    "//base",
    "//services/image_annotation/public/mojom",
    "//skia",
    "//ui/gfx/codec",
  ]

  if (is_cobalt) {
    # Cobalt: Depend on metrics directly to avoid pulling in annotator and components/manta.
    public_deps += [ "//services/image_annotation:metrics" ]
  } else {
    public_deps += [ "//services/image_annotation:lib" ]
  }
}

source_set("tests") {
  testonly = true

  sources = [ "image_processor_unittest.cc" ]

  deps = [
    ":cpp",
    "//base",
    "//base/test:test_support",
    "//testing/gmock",
    "//testing/gtest",
    "//ui/gfx/codec",
  ]

  if (is_cobalt) {
    deps += [ "//services/image_annotation:metrics" ]
  } else {
    deps += [ "//services/image_annotation:lib" ]
  }
}
