// Zero-JS-buffer fetch Response body reader for WebAssembly. JavaScript issues
// fetch() through Chromium's network stack and hands the Response to
// adoptResponse(), which locks the body and extracts its Blink BytesConsumer
// without allocating per-chunk Uint8Arrays. Wasm then pulls bytes directly into
// the WebAssembly.Memory bound on H5vccWasmImports via read(), and releases the
// stream via close().
// See h_5_vcc_wasm_imports.idl and cobalt/wasm/starboard/wasm_starboard_abi.h.
[
    Exposed=(Window,DedicatedWorker),
    RuntimeEnabled=H5vccWasmImports,
    SecureContext
]
interface H5vccWasmNet {
  // Extracts and locks `response`'s body stream; returns a positive streamId
  // (>= 1, never reused). Throws TypeError if `response`'s body is locked,
  // already used, opaque, or an error response.
  [CallWith=ScriptState, RaisesException] long adoptResponse(Response response);

  // Reads up to `capacity` bytes directly from `streamId`'s BytesConsumer into
  // bound guest memory at `[dstOffset, dstOffset + capacity)`.
  // Returns:
  //   > 0 : bytes copied
  //     0 : kWasmNetPending (arms one kWasmSbEventNetReady + onwake)
  //    -1 : kWasmNetEof (clean end of stream)
  //    -2 : kWasmNetError (network error or invalid streamId / bounds)
  //    -3 : kWasmNetAborted (fetch AbortSignal aborted)
  [CallWith=Isolate, NoAllocDirectCall]
  long read(long streamId, unsigned long dstOffset, unsigned long capacity);

  // Cancels and releases `streamId`'s BytesConsumer and drops any queued
  // kWasmSbEventNetReady event for it.
  [NoAllocDirectCall] undefined close(long streamId);
};
