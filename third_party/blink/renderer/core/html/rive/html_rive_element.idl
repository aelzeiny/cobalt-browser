[
    Exposed=Window,
    HTMLConstructor
] interface HTMLRiveElement : HTMLElement {
    [CEReactions] attribute USVString src;
    [CEReactions] attribute DOMString artboard;
    [CEReactions] attribute DOMString stateMachine;
    [CEReactions] attribute DOMString animation;
    [CEReactions] attribute DOMString fit;
    [CEReactions] attribute DOMString alignment;
    [CEReactions] attribute DOMString viewModel;
    [CEReactions] attribute boolean autoplay;

    readonly attribute boolean paused;
    // True while the player is still producing frames (e.g. a scroll is
    // settling); false once everything has come to rest.
    readonly attribute boolean animating;
    readonly attribute boolean loaded;
    readonly attribute double artboardWidth;
    readonly attribute double artboardHeight;
    readonly attribute DOMString lastEventName;

    readonly attribute FrozenArray<DOMString> artboardNames;
    readonly attribute FrozenArray<DOMString> stateMachineNames;
    readonly attribute FrozenArray<DOMString> animationNames;
    readonly attribute FrozenArray<DOMString> inputNames;

    void play();
    void pause();
    void stop();
    boolean advance(double seconds);

    boolean loadFromBuffer(ArrayBuffer data);

    // State Machine inputs
    boolean setBooleanInput(DOMString name, boolean value);
    boolean getBooleanInput(DOMString name);
    boolean setNumberInput(DOMString name, double value);
    double getNumberInput(DOMString name);
    boolean fireTrigger(DOMString name);

    // Text runs
    boolean setTextRun(DOMString name, DOMString value);
    DOMString getTextRun(DOMString name);

    // ViewModel data binding
    boolean setViewModelNumber(DOMString path, double value);
    double getViewModelNumber(DOMString path);
    boolean setViewModelBoolean(DOMString path, boolean value);
    boolean getViewModelBoolean(DOMString path);
    boolean setViewModelString(DOMString path, DOMString value);
    DOMString getViewModelString(DOMString path);
    boolean setViewModelColor(DOMString path, long argb);
    long getViewModelColor(DOMString path);
    boolean setViewModelEnum(DOMString path, DOMString value);
    DOMString getViewModelEnum(DOMString path);
    boolean fireViewModelTrigger(DOMString path);

    // ViewModel lists. setListItems() replaces the list at `listPath` with one
    // new instance of the ViewModel `viewModel` per entry; each entry maps
    // property names to values, parsed by the property's type (string, number,
    // "true"/"false", "#rrggbb"/"#aarrggbb" colours, enum names, and image
    // URLs, which load asynchronously).
    boolean setListItems(DOMString listPath, DOMString viewModel,
                         sequence<record<DOMString, DOMString>> items);
    // Like setListItems() but appends, keeping existing items, focus and
    // scroll position (e.g. for continuations).
    boolean appendListItems(DOMString listPath, DOMString viewModel,
                            sequence<record<DOMString, DOMString>> items);
    unsigned long listItemCount(DOMString listPath);
    // Scrolls the list so item `index` sits at the start (mounting it if it
    // was virtualized away) and gives it Rive focus, e.g. to restore a
    // remembered selection. Returns false if it can't.
    boolean focusListItem(DOMString listPath, unsigned long index);
    // Like focusListItem() but only scrolls; focus is unchanged.
    boolean scrollToListItem(DOMString listPath, unsigned long index);
    DOMString getListItemValue(DOMString listPath, unsigned long index,
                               DOMString property);
    // Sets one property of item `index`, parsed like setListItems() values
    // (e.g. "" clears an image). Returns false if there is no such item.
    boolean setListItemValue(DOMString listPath, unsigned long index,
                             DOMString property, DOMString value);

    // Focus and navigation within the artboard. moveFocus() accepts "left",
    // "right", "up", "down", "next" or "previous" and returns false when there
    // is nothing to move to in that direction.
    readonly attribute boolean hasFocusNodes;
    readonly attribute boolean hasRiveFocus;
    boolean moveFocus(DOMString direction);
    void clearFocus();
};
