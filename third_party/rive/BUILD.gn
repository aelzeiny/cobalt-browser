# Cobalt's interface to Rive Renderer, which keeps Rive Renderer's headers and
# GL macros out of Blink.
source_set("rive_renderer_gl") {
  sources = [
    "cobalt/rive_renderer_gl.cc",
    "cobalt/rive_renderer_gl.h",
  ]
  cflags_cc = [ "-fno-complete-member-pointers" ]
  configs += [ "//third_party/khronos:khronos_headers" ]
  public_deps = [ ":rive" ]
  deps = [
    ":rive_renderer",
    "//gpu/command_buffer/client:gles2_c_lib",
  ]
}
