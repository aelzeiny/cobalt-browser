# Rive Renderer (GPU), GL backend only. GL calls go through Chromium's GPU
# command buffer: Chromium's GLES2/gl2.h maps gl* to the GLES2* entry points
# of //gpu/command_buffer/client:gles2_c_lib, which forward to the
# GLES2Interface made current with gles2::SetGLContext().
config("rive_renderer_public_config") {
  include_dirs = [ "renderer/include" ]
  defines = [ "RIVE_CHROMIUM_GL" ]
}

