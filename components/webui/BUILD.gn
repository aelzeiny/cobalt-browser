import("//components/safe_browsing/buildflags.gni")

group("resources") {
  public_deps = [
    "chrome_urls/resources:resources",
    "flags/resources:resources",
    "internal_debug_pages_disabled/resources:resources",
    "user_actions/resources:resources",
    "version/resources:resources",
  ]

  # Cobalt: safe browsing WebUI debug pages are not used on TV.
  if (safe_browsing_mode > 0) {
    public_deps += [ "safe_browsing/resources" ]
  }
}
