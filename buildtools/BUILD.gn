    "//third_party/perfetto/buildtools/lzma/C",
    "//third_party/perfetto/buildtools/zstd/lib",
  ]
  if (is_starboard) {
    include_dirs += [ "//buildtools/custom_includes" ]
  }
  deps = [
    ":lzma",
    ":zlib",
    ":zstd",
  ]
  sources = [
    "//third_party/perfetto/buildtools/android-libbase/file.cpp",
    "//third_party/perfetto/buildtools/android-libbase/stringprintf.cpp",
    "//third_party/perfetto/buildtools/android-libbase/strings.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/ArmExidx.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/Demangle.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/DwarfCfa.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/DwarfEhFrameWithHdr.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/DwarfMemory.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/DwarfOp.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/DwarfSection.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/Elf.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/ElfInterface.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/ElfInterfaceArm.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/Global.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/JitDebug.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/MapInfo.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/Maps.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/Memory.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/MemoryXz.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/Regs.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/RegsArm.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/RegsArm64.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/RegsRiscv64.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/RegsX86.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/RegsX86_64.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/Symbols.cpp",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/Unwinder.cpp",
  ]
  if (!is_android) {
    sources += [
      "//third_party/perfetto/buildtools/android-libbase/liblog_symbols.cpp",
      "//third_party/perfetto/buildtools/android-libbase/logging.cpp",
      "//third_party/perfetto/buildtools/android-libbase/threads.cpp",
      "//third_party/perfetto/buildtools/android-logging/liblog/logger_write.cpp",
      "//third_party/perfetto/buildtools/android-logging/liblog/properties.cpp",
      "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/LogStdout.cpp",
      "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/MemoryMte.cpp",
    ]
  } else {
    sources += [ "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/LogAndroid.cpp" ]
  }
  if (current_cpu == "x86") {
    sources += [ "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/AsmGetRegsX86.S" ]
  } else if (current_cpu == "x64") {
    sources += [ "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/AsmGetRegsX86_64.S" ]
  }
  cflags = [ "-DFAKE_LOG_DEVICE=1" ]
  if (!is_win) {
    cflags += [
      "-Wno-deprecated-declarations",
      "-Wno-format-zero-length",
    ]
    if (is_clang) {
      cflags += [
        "-Wno-vla-cxx-extension",
        "-Wno-c99-designator",
      ]
    }
  }
  public_configs = [ ":libunwindstack_config" ]
}

