config("zlib_config") {
  defines = [
    "ZLIB_IMPLEMENTATION",
    "CHROMIUM_ZLIB_NO_CHROMECONF",
  ]
  cflags = [
    "-isystem",
    rebase_path("//third_party/perfetto/buildtools/zlib", root_build_dir),
  ]
  if (is_clang) {
    cflags += [
      "-Wno-unknown-warning-option",
      "-Wno-deprecated-non-prototype",
      "-Wno-macro-redefined",
      "-Wno-implicit-fallthrough",
    ]
  }
}

