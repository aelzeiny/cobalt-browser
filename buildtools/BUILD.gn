# Custom buildtools/BUILD.gn to compile libunwindstack and its dependencies
# (lzma, zlib, zstd) for Perfetto heap profiling on Linux/RDK.
# Paths are rebased to point to //third_party/perfetto/buildtools/.
# Removed internal Perfetto default_deps to bypass visibility restrictions.

config("libunwindstack_config") {
  cflags = [
    "-isystem",
    rebase_path("//third_party/perfetto/buildtools/android-unwinding/libunwindstack/include", root_build_dir),
    "-isystem",
    rebase_path("//third_party/perfetto/buildtools/android-libprocinfo/include", root_build_dir),
    "-isystem",
    rebase_path("//third_party/perfetto/buildtools/android-libbase/include", root_build_dir),
    "-isystem",
    rebase_path("//third_party/perfetto/buildtools/android-core/demangle/include", root_build_dir),
    "-isystem",
    rebase_path("//third_party/perfetto/buildtools/rustc-demangle-capi", root_build_dir),
  ]
  if (is_starboard) {
    cflags += [
      "-isystem",
      rebase_path("//buildtools/custom_includes", root_build_dir),
    ]
  }
  defines = [
    "NO_LIBDEXFILE_SUPPORT",
    "NT_RISCV_VECTOR=0x901",
    "ELFCOMPRESS_ZSTD=2",
  ]
}

source_set("libunwindstack") {
  include_dirs = [
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack/include",
    "//third_party/perfetto/buildtools/android-unwinding/libunwindstack",
