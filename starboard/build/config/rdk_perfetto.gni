declare_args() {
  # Build the device-side Perfetto tools (traced, perfetto, heapprofd and the
  # LD_PRELOAD malloc client) for the RDK ARM target.
  #
  # Off by default. These targets live in the "native_target" toolchain, and
  # instantiating them drags the RDK Starboard tree into a non-Starboard
  # toolchain, which trips the file-scope
  #
  #   assert(is_starboard_toolchain)
  #
  # in //starboard/contrib/rdk/src/third_party/starboard/rdk/shared/BUILD.gn.
  # libcobalt.so does not need them: they are standalone daemons that get
  # copied to /data on the device once and reused across Cobalt builds.
  rdk_build_perfetto_native_tools = false
}
